# Environment for the Market Intelligence Terminal. Copy to .env.local for local
# work, or set these on the host or container. Never commit real values.
# Every variable is optional: the app builds and runs with none set, and each
# feature that needs one says so on the page instead of failing.

# ---- Access ----

# Password gate for the whole site. Optional; default unset, which leaves the site open.
# When set, every page redirects to /login until this password is entered.
SITE_PASSWORD=

# ---- Public data ----

# Declared contact for requests to www.sec.gov (SEC fair-access rule). Optional; default unset.
# Needed for Revenue mix, segment history and management commentary; without it they say sec.gov can't be read.
# Format: an app or company name followed by a contact email.
SEC_USER_AGENT="Market Terminal you@example.com"

# Korea Customs export data key from data.go.kr. Not read yet; reserved for the
# Korea adapter in the cycle engine (docs/cycle-engine.md). Optional; default unset.
KCS_SERVICE_KEY=

# ---- Claude (AI features) ----

# Claude API key for news "why it matters", management commentary, Ask and QBR talking points.
# Optional; default unset, and AI features say they are off.
ANTHROPIC_API_KEY=

# Alternative Claude credential (a bearer token, e.g. from a gateway). Optional; default unset.
# Either this or ANTHROPIC_API_KEY turns AI features on.
ANTHROPIC_AUTH_TOKEN=

# ---- Storage ----

# Where saved results (AI answers, talking points, digests) and line card snapshots live.
# Optional; default "file", which writes JSON under .cache and data/line-cards on local disk.
STORE_ADAPTER=file

# ---- Avnet data and database (being added) ----
# Placeholder. Variables for Avnet's Databricks data and the provisioned database
# (Oracle or Databricks) are being added with the Avnet data layer; they will be
# documented here.

# ---- Development only ----

# Base URL the Ask eval script calls (src/lib/ask/eval.ts). Dev only; default http://localhost:3002.
ASK_EVAL_URL=

# Base URL the QBR eval script calls (src/lib/qbr/eval.ts). Dev only; default http://localhost:3002.
QBR_EVAL_URL=

# Build folder for a second local dev server, e.g. NEXT_DIST_DIR=.next-kit next dev -p 3012.
# Dev only; default .next. Next rewrites tsconfig.json when this changes, so restore it afterwards.
NEXT_DIST_DIR=
