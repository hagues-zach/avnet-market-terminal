# Environment for the Market Intelligence Terminal. Copy to .env.local for local
# work, or set these on the host or container. Never commit real values.
# Every variable is optional: the app builds and runs with none set, and each
# feature that needs one says so on the page instead of failing.

# ---- Access ----

# Password gate for the whole site. Optional; default unset, which leaves the site open.
# When set, every page redirects to /login until this password is entered.
SITE_PASSWORD=

# ---- Public data ----

# Declared contact for requests to www.sec.gov (SEC fair-access rule). Optional; default unset.
# Needed for Revenue mix, segment history and management commentary; without it they say sec.gov can't be read.
# Format: an app or company name followed by a contact email.
SEC_USER_AGENT="Market Terminal you@example.com"

# Korea Customs export data key from data.go.kr. Not read yet; reserved for the
# Korea adapter in the cycle engine (docs/cycle-engine.md). Optional; default unset.
KCS_SERVICE_KEY=

# ---- Claude (AI features) ----

# Claude API key for news "why it matters", management commentary, Ask and QBR talking points.
# Optional; default unset, and AI features say they are off.
ANTHROPIC_API_KEY=

# Alternative Claude credential (a bearer token, e.g. from a gateway). Optional; default unset.
# Either this or ANTHROPIC_API_KEY turns AI features on.
ANTHROPIC_AUTH_TOKEN=

# ---- Storage ----

# Where saved results (AI answers, talking points, digests) and line card snapshots live.
# Optional; default "file", which writes JSON under .cache and data/line-cards on local disk.
# "databricks" or "oracle" use the provisioned database: run the table scripts in
# db/migrations first (docs/storage.md).
STORE_ADAPTER=file

# Where the store's tables live with STORE_ADAPTER=databricks (writable). Required for it.
# The Databricks connection itself is DATABRICKS_HOST, _TOKEN and _WAREHOUSE_ID below.
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Oracle connection for STORE_ADAPTER=oracle (thin mode, no Oracle client install). Required for it.
# ORACLE_CONNECT_STRING is host:port/service_name or a TNS descriptor.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=

# ---- Avnet data ----
# Avnet's own figures (billings, bookings, backlog, pipeline, customers, code map)
# and the licensed market data, read through src/lib/avnet. docs/data-contracts.md
# describes every dataset and the Databricks view it comes from.

# Which adapter supplies Avnet's figures. Optional; default "mock" (synthetic numbers, marked Mock on every page).
# "databricks" reads the terminal_* views; without the DATABRICKS_* settings below, pages fail with an
# error naming what's missing rather than showing mock numbers.
# Check the views first: AVNET_DATA=databricks npx tsx scripts/check-avnet-data.ts
AVNET_DATA=mock

# Datasets to take from the mock while AVNET_DATA=databricks, comma separated, for sources not in
# Databricks yet. Optional; default unset. Any of: fiscalCalendar, performance, segments, regions,
# suppliers, verticals, pipeline, customers, codeMap, supply, markets, account. When any is set,
# pages mark Avnet's figures as Mock. Example: markets,supply
AVNET_MOCK_DATASETS=

# Minutes to keep Avnet's figures between queries. Optional; default 15.
AVNET_CACHE_MINUTES=

# Databricks workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net. Required for AVNET_DATA=databricks
# and STORE_ADAPTER=databricks.
DATABRICKS_HOST=

# Personal access token or service principal token. Required with DATABRICKS_HOST. Never commit it.
DATABRICKS_TOKEN=

# The SQL warehouse that runs the queries. Required with DATABRICKS_HOST.
DATABRICKS_WAREHOUSE_ID=

# Where the terminal_* views live (read-only). Optional; default gold and market_intelligence.
AVNET_DATA_CATALOG=
AVNET_DATA_SCHEMA=

# ---- Development only ----

# Base URL the Ask eval script calls (src/lib/ask/eval.ts). Dev only; default http://localhost:3002.
ASK_EVAL_URL=

# Base URL the QBR eval script calls (src/lib/qbr/eval.ts). Dev only; default http://localhost:3002.
QBR_EVAL_URL=

# Build folder for a second local dev server, e.g. NEXT_DIST_DIR=.next-kit next dev -p 3012.
# Dev only; default .next. Next rewrites tsconfig.json when this changes, so restore it afterwards.
NEXT_DIST_DIR=
